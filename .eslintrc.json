{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off",
    "no-extra-semi": "off",
    "no-redeclare": "off",
    "no-case-declarations": "off"
  },
  "ignorePatterns": ["dist/", "node_modules/", "*.config.ts"]
}
